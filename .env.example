# Keenetic router connection
KEENETIC_HOST=http://192.168.1.1
KEENETIC_USER=admin
KEENETIC_PASS=your_password_here

# MCP server
MCP_SECRET=your_secret_token_here
MCP_PORT=9584

# Config backup (optional)
# Set BACKUP_ENABLED=true to activate scheduled backups
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 11 * * 0
# BACKUP_SCHEDULE examples:
#   0 11 * * 0   — every Sunday at 11:00
#   0 3  * * *   — every day at 03:00
#   0 */6 * * *  — every 6 hours

# Remote destination via rsync over SSH (recommended)
# If set, backup is written to /tmp (RAM) and synced — flash is not used
# If not set, backup is stored locally in BACKUP_PATH
BACKUP_RSYNC_HOST=
BACKUP_RSYNC_USER=
BACKUP_RSYNC_KEY=/opt/etc/keenetic-backup-rsa
BACKUP_RSYNC_PATH=/share/backups/keenetic

# Local fallback (used only if BACKUP_RSYNC_HOST is not set)
BACKUP_PATH=/opt/var/backup/keenetic
BACKUP_KEEP=8

# Back up this server's own unversioned files alongside the router config
# (2.7.3, rsync destination only). .env and watch_rules.json are gitignored
# and the Entware init script is hand-edited, so `git pull` restores none of
# them — after a dead USB stick or a rebuilt NAS volume they are simply gone.
# Every run refreshes <BACKUP_RSYNC_PATH>/mcp-config/ ; a dated snapshot
# mcp-config-YYYY-MM-DD/ is written only when the content actually changed,
# detected against manifest.json inside the mirror. Nothing is deleted on the
# receiver and nothing is written to the USB stick (staging is /tmp = RAM).
# The rsync private key is deliberately excluded: it regenerates in a minute,
# and storing it on the share it unlocks buys nothing.
BACKUP_MCP_CONFIG=true
BACKUP_MCP_INIT=/opt/etc/init.d/S99keenetic-mcp

# Protected objects for the write tools (optional, comma-separated).
# The write tools refuse to touch anything listed here. The MCP's own port
# (MCP_PORT), its 127.0.0.1:<MCP_PORT> upstream and the "keenetic-mcp" proxy
# name are ALWAYS protected automatically — you never need to list them, and
# they cannot be disabled. Use the vars below to protect anything else you
# don't want an LLM to be able to break: Home Assistant, other MCP servers,
# your own services.
#   MCP_PROTECTED_PORTS         — external ports that must not be forwarded/removed
#   MCP_PROTECTED_PROXY_NAMES   — KeenDNS proxy names that must not be changed/removed
#   MCP_PROTECTED_UPSTREAMS     — host:port upstreams that must not be pointed at
# Leave empty to protect only this server's own channel.
MCP_PROTECTED_PORTS=8123,9583,3100,3200,7612
MCP_PROTECTED_PROXY_NAMES=ha-mcp,vault-mcp,adb-mcp,homeassistant,ntfy
MCP_PROTECTED_UPSTREAMS=

# Plain-HTTP tool route (optional)
#   GET /<MCP_SECRET>/tool/<name>?arg=value   -> {"ok":true,"result":...}
#   GET /<MCP_SECRET>/tool/<name>?...&raw=1   -> the tool's text, unwrapped
#   GET /<MCP_SECRET>/tools                   -> what is servable right now
# For Home Assistant (rest_command, rest sensor, command_line), which cannot
# speak MCP. A URL is a weak credential, so this route is READ-ONLY: tools
# that change router state (all write tools, reboot, register/update/block/
# unblock_client, backup_config, backup_mcp_config, dump_log) return 403
# unless you name them below. Reboot already has its own dedicated endpoint,
# /<MCP_SECRET>/reboot.
MCP_HTTP_TOOLS=true
# Comma-separated tool names allowed over HTTP even though they mutate state.
# Empty = every read-only tool, no mutating ones. Example: register_client
MCP_HTTP_TOOL_ALLOWLIST=

# Event watcher (optional)
# A background thread polls the router locally and makes an outbound HTTP call
# when a rule matches. Rules live in a JSON file on the router; see
# watch_rules.example.json and the README. With no rules file the watcher does
# not start.
MCP_WATCH=true
# Rules file. Relative paths are resolved next to server.py.
MCP_WATCH_RULES=watch_rules.json
# Watcher state: last seen log position, previous RCI snapshots, cooldowns.
# Keep it in /tmp (RAM) — this project does not write to the USB stick.
MCP_WATCH_STATE=/tmp/keenetic-mcp-watch.json
# Default seconds between log polls. A rule can override it with "interval".
MCP_WATCH_INTERVAL=10
# UPPERCASE names referenced from watch_rules.json as $NAME are read from here,
# so the rules file itself stays free of tokens, chat ids and proxy passwords.
# Substitution applies to a rule's url, headers, proxy and body. Examples:
# TG_TOKEN=123456:AA...
# TG_CHAT_ID=100000000
# TG_PROXY=http://user:password@203.0.113.10:14346
