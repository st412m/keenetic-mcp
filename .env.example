# Keenetic router connection
KEENETIC_HOST=http://192.168.1.1
KEENETIC_USER=admin
KEENETIC_PASS=your_password_here

# MCP server
MCP_SECRET=your_secret_token_here
MCP_PORT=9584

# Config backup (optional)
# Set BACKUP_ENABLED=true to activate scheduled backups
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 11 * * 0
# BACKUP_SCHEDULE examples:
#   0 11 * * 0   — every Sunday at 11:00
#   0 3  * * *   — every day at 03:00
#   0 */6 * * *  — every 6 hours

# Remote destination via rsync over SSH (recommended)
# If set, backup is written to /tmp (RAM) and synced — flash is not used
# If not set, backup is stored locally in BACKUP_PATH
BACKUP_RSYNC_HOST=
BACKUP_RSYNC_USER=
BACKUP_RSYNC_KEY=/opt/etc/keenetic-backup-rsa
BACKUP_RSYNC_PATH=/share/backups/keenetic

# Local fallback (used only if BACKUP_RSYNC_HOST is not set)
BACKUP_PATH=/opt/var/backup/keenetic
BACKUP_KEEP=8

# Protected objects for the write tools (optional, comma-separated).
# The write tools refuse to touch anything listed here. The MCP's own port
# (MCP_PORT), its 127.0.0.1:<MCP_PORT> upstream and the "keenetic-mcp" proxy
# name are ALWAYS protected automatically — you never need to list them, and
# they cannot be disabled. Use the vars below to protect anything else you
# don't want an LLM to be able to break: Home Assistant, other MCP servers,
# your own services.
#   MCP_PROTECTED_PORTS         — external ports that must not be forwarded/removed
#   MCP_PROTECTED_PROXY_NAMES   — KeenDNS proxy names that must not be changed/removed
#   MCP_PROTECTED_UPSTREAMS     — host:port upstreams that must not be pointed at
# Leave empty to protect only this server's own channel.
MCP_PROTECTED_PORTS=8123,9583,3100,3200,7612
MCP_PROTECTED_PROXY_NAMES=ha-mcp,vault-mcp,adb-mcp,homeassistant,ntfy
MCP_PROTECTED_UPSTREAMS=
